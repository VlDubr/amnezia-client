{
	# Clients that connect by IP address send no SNI: answer them with the panel's certificate.
	default_sni {$PANEL_DOMAIN}
}

# PANEL_TLS=acme (default): a public certificate from Let's Encrypt for the domain in PANEL_DOMAIN.
(tls-acme) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# PANEL_TLS=self-signed: the certificate made by gen-self-signed-cert.sh (PANEL_DOMAIN may be an IP address).
# No HSTS here: it would stop browsers from letting the visitor accept the certificate.
(tls-self-signed) {
	tls /certs/panel.crt /certs/panel.key
}

{$PANEL_DOMAIN} {
	import tls-{$PANEL_TLS:acme}

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Hashed build files never change: cache them for a year, and answer 404 (not index.html) for old names.
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html must be revalidated so a redeploy is picked up at once.
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
