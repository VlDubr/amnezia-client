# Address of the panel: a domain name, or the server's IP address when PANEL_TLS=self-signed.
PANEL_DOMAIN=panel.example.com

# How the panel gets its HTTPS certificate:
#   acme         - a free public certificate from Let's Encrypt (needs a domain name pointing at this server)
#   self-signed  - your own certificate, for a panel without a domain; make it first:
#                  ./gen-self-signed-cert.sh <PANEL_DOMAIN>
PANEL_TLS=acme

# Database password (any long random string).
POSTGRES_PASSWORD=change-me

# 32-byte key that encrypts SSH credentials and client keys in the database.
# Generate once:  openssl rand -base64 32
# KEEP A COPY OUTSIDE THE SERVER: without it a database backup cannot be restored.
PANEL_MASTER_KEY=

# Timezone that defines "days" for access expiry and traffic statistics.
PANEL_TZ=Europe/Moscow

# DNS servers written into client configs.
PANEL_DNS1=1.1.1.1
PANEL_DNS2=1.0.0.1

# How many days of daily database backups to keep.
BACKUP_KEEP_DAYS=14
